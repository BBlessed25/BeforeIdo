# Server-only configuration for the Singles registration API.
SINGLES_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/SINGLES_DEPLOYMENT_ID/exec
SINGLES_SHARED_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGIN=https://your-domain.example
# Set SINGLES_SPREADSHEET_ID and the matching SINGLES_SHARED_SECRET in Apps Script properties.
